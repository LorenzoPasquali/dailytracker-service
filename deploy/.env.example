# Copy to ".env" next to docker-compose.yml on the VPS and fill in real values.
# Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=dailytracker
POSTGRES_USER=dailytracker
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend (service) ---
JWT_SECRET=change-me-long-random-secret
AES_SECRET=change-me-32-char-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
RESEND_API_KEY=your-resend-api-key

# Public URL of the frontend (used for OAuth redirects / links)
FRONTEND_URL=https://app.seudominio.com

# Notifications (optional overrides)
NOTIFICATIONS_FROM_EMAIL=noreply@dailytracker.app
NOTIFICATIONS_FROM_NAME=DailyTracker
NOTIFICATIONS_ENABLED=true

# --- Frontend (app) ---
# Public URL where the backend is reachable from the browser
VITE_API_URL=https://api.seudominio.com
